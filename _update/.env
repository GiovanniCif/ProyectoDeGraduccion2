# Cuenta y etiquetas de Docker Hub
DOCKERHUB_USERNAME=
IMAGE_TAG=1.0.0

# Puerto donde se abrirá el sistema: http://localhost:8080
APP_PORT=8080

# MySQL. Usa valores privados y no subas el archivo .env real.
MYSQL_DATABASE=
MYSQL_USER=sge_
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT: mínimo 32 caracteres; se recomienda una cadena aleatoria de 64 o más.
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRE_MINUTES=

# Solo se utiliza cuando se crea por primera vez el usuario administrador.
ADMIN_PASSWORD=
